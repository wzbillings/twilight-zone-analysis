# Legacy scaffold guards only: real source data belong outside this working tree.
# .gitignore is defense-in-depth; see docs/TZ_PROJECT_PLAN.md#storage-architecture.
data/raw/video/*
data/raw/audio/*
data/raw/transcripts/*
!data/raw/video/.gitkeep
!data/raw/audio/.gitkeep
!data/raw/transcripts/.gitkeep

# Local output guards; large derived data and caches belong in external non-Git storage.
output/models/*
output/figures/*
output/tables/*
!output/models/.gitkeep
!output/figures/.gitkeep
!output/tables/.gitkeep
